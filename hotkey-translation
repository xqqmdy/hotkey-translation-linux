#!/usr/bin/env python3
"""hotkey-translation: type source-language text in fuzzel, get the target language in the clipboard.

Flow: Mod+Y pops a fuzzel input, type Chinese, Enter; translation lands in
the clipboard with a notification, Ctrl+V pastes it anywhere. Rime is driven
to Chinese while the input window is open and left in English after Enter.
The model is never asked for in this flow: `hotkey-translation --pick` opens a
live free-model list (fetched from OpenRouter, not a curated list).

Config: ~/.config/hotkey-translation/config.toml (see config.example.toml).
Env overrides: HT_CONFIG, OPENROUTER_API_KEY, OPENROUTER_BASE_URL,
HT_TEXT (skip input prompt), HT_MODEL (skip model resolution).
Fallback: no fuzzel binary -> translate clipboard content directly.
Stdlib only.
"""

import json
import os
import shutil
import subprocess
import sys
import time
import tomllib
import urllib.request

DEFAULT_BASE_URL = "https://openrouter.ai/api/v1"
CONFIG_DEFAULT = os.path.expanduser("~/.config/hotkey-translation/config.toml")

# ISO-ish codes mapped to the names used in the prompt. Unknown codes are
# passed through as-is, so any language code the model understands works.
LANG_NAMES = {
    "zh": "Chinese", "zh-cn": "Chinese", "zh-tw": "Traditional Chinese",
    "en": "English", "ja": "Japanese", "ko": "Korean", "fr": "French",
    "de": "German", "es": "Spanish", "ru": "Russian", "pt": "Portuguese",
    "it": "Italian", "nl": "Dutch", "pl": "Polish", "tr": "Turkish",
    "ar": "Arabic", "hi": "Hindi", "th": "Thai", "vi": "Vietnamese",
    "id": "Indonesian", "uk": "Ukrainian", "sv": "Swedish",
}

# Rime's ascii mode can only switch between these two, so the IME helper is
# limited to Chinese <-> English. Other source languages leave the IME alone.
IME_SOURCE = {"zh", "zh-cn", "zh-tw", "zh-hans", "zh-hant"}


def lang_name(code):
    code = (code or "").strip()
    if not code:
        return ""
    return LANG_NAMES.get(code.lower(), code)


def build_prompt(src_code, dst_code):
    src = lang_name(src_code) or "the source language"
    dst = lang_name(dst_code) or "the target language"
    return (
        f"Translate the user's {src} text into natural, idiomatic {dst}. "
        f"Output ONLY the {dst} translation as plain text: no explanations, "
        "no quotation marks, no romanization, no alternatives. "
        f"Single word in, single most common {dst} equivalent out. "
        f"Sentence in, one faithful {dst} sentence out."
    )


def notify(title, body=""):
    try:
        subprocess.run(
            ["notify-send", title, body[:400]], check=False,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
    except OSError:
        pass


def die(title, detail="", code=1):
    msg = f"{title}: {detail}" if detail else title
    print(f"hotkey-translation: {msg}", file=sys.stderr)
    notify("translation failed", msg[:400])
    sys.exit(code)


def load_config(path):
    try:
        with open(path, "rb") as f:
            return tomllib.load(f)
    except FileNotFoundError:
        return {}
    except OSError as e:
        die("cannot read config", f"{path}: {e}", 2)
    except tomllib.TOMLDecodeError as e:
        die("bad config TOML", f"{path}: {e}", 2)


def read_clipboard():
    for args in (["wl-paste", "--no-newline"], ["wl-paste", "--primary", "--no-newline"]):
        try:
            p = subprocess.run(args, capture_output=True, text=True, timeout=5)
        except (OSError, subprocess.TimeoutExpired):
            continue
        if p.returncode == 0 and p.stdout.strip():
            return p.stdout.strip()
    return ""


def dbg(msg):
    if os.environ.get("HT_DEBUG"):
        try:
            with open("/tmp/hotkey-translation-debug.log", "a") as f:
                f.write(f"{time.monotonic():.2f} {msg}\n")
        except OSError:
            pass


# The only reliable Chinese/English judge is rime's ascii mode
# (IsAsciiMode false = Chinese, true = English). fcitx's 1/2 state does NOT
# track it, so it is deliberately not used here.
def rime_ascii():
    if shutil.which("busctl") is None:
        return None
    try:
        p = subprocess.run(["busctl", "--user", "call", "org.fcitx.Fcitx5",
                            "/rime", "org.fcitx.Fcitx.Rime1", "IsAsciiMode"],
                           capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if p.returncode != 0:
        return None
    out = p.stdout.strip()
    if out.endswith("true"):
        return True
    if out.endswith("false"):
        return False
    return None


def rime_set_ascii(value):
    """Set rime ascii mode on the focused input context (True = English)."""
    if shutil.which("busctl") is None:
        return False
    try:
        p = subprocess.run(["busctl", "--user", "call", "org.fcitx.Fcitx5",
                            "/rime", "org.fcitx.Fcitx.Rime1", "SetAsciiMode",
                            "b", "true" if value else "false"],
                           capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return p.returncode == 0


def rime_apply(want, attempts=6, settle=0.3):
    """Drive ascii mode to `want`, verifying each step. Returns final state."""
    for _ in range(attempts):
        cur = rime_ascii()
        dbg(f"rime apply want={want} cur={cur}")
        if cur is None or cur == want:
            return cur
        if not rime_set_ascii(want):
            return cur
        time.sleep(settle)
    return rime_ascii()


def fuzzel(args, stdin_text):
    try:
        p = subprocess.run(["fuzzel", *args], input=stdin_text,
                           capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if p.returncode != 0:
        return None  # Esc / cancel
    return p.stdout.strip()


def prompt_text(placeholder, ime_source):
    args = ["--dmenu", "--prompt", "translate> ",
            "--placeholder", placeholder,
            "--width", "60", "--lines", "0"]
    try:
        proc = subprocess.Popen(["fuzzel", *args], stdin=subprocess.PIPE,
                                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                text=True)
    except OSError:
        return None
    prev = rime_ascii()
    dbg(f"rime ascii prev={prev}")
    # fuzzel shows its window only after stdin EOF, so close it first, then
    # drive the popup's input context to the source language. Rime only knows
    # Chinese vs English, so this runs solely for a Chinese source.
    # No keystroke synthesis: the D-Bus setter hits the focused context and
    # is verified.
    try:
        proc.stdin.write("")
        proc.stdin.close()
    except (BrokenPipeError, OSError):
        pass
    use_ime = prev is not None and ime_source
    if use_ime:
        time.sleep(0.15)
        rime_apply(False)
    try:
        out, _ = proc.communicate(timeout=120)
    except subprocess.TimeoutExpired:
        proc.kill()
        out, _ = proc.communicate()
    finally:
        # Enter means done: leave the input context in English so the next
        # keystrokes in the app are English. This is deliberate, not a
        # restore of the pre-open mode.
        if use_ime:
            time.sleep(0.3)
            rime_apply(True)
    if proc.returncode != 0:
        return None  # Esc / cancel
    return out.strip() or None


def prompt_model(models, current):
    """Live free-model picker: tab columns, display name+context+id,
    return the id column."""
    lines = []
    for m in models:
        lines.append("\t".join([m["id"], m["name"], m["ctx"]]))
    args = ["--dmenu", "--prompt", "model> ",
            "--tabs", "2",
            "--with-nth", "{2}  {3}  [{1}]",
            "--accept-nth", "1",
            "--lines", "10", "--width", "60"]
    if current:
        args += ["--select", current]
    out = fuzzel(args, "\n".join(lines) + "\n")
    return out.strip() if out else None


CACHE_DIR = os.path.expanduser("~/.cache/hotkey-translation")
MODELS_CACHE = os.path.join(CACHE_DIR, "models.json")
LAST_MODEL = os.path.join(CACHE_DIR, "last_model")
MODELS_TTL = 86400


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def write_json(path, data):
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            json.dump(data, f)
        os.replace(tmp, path)
    except OSError:
        pass


def fetch_models(base_url, ttl):
    """Free models live from OpenRouter /models, cached for `ttl` seconds.
    Falls back to stale cache; empty list when nothing is available."""
    cached = read_json(MODELS_CACHE)
    if isinstance(cached, dict):
        age = time.time() - cached.get("fetched", 0)
        if cached.get("base") == base_url and age < ttl and cached.get("models"):
            return cached["models"]
    url = base_url.rstrip("/") + "/models"
    try:
        req = urllib.request.Request(url, headers={
            "HTTP-Referer": "https://github.com/xqqmdy/hotkey-translation",
            "X-Title": "hotkey-translation",
        })
        with urllib.request.urlopen(req, timeout=15) as resp:
            payload = json.loads(resp.read().decode())
        rows = payload.get("data") or []
    except (urllib.error.URLError, ValueError, OSError):
        rows = []
    models = []
    for row in rows:
        mid = row.get("id") or ""
        if not mid:
            continue
        arch = row.get("architecture") or {}
        outs = arch.get("output_modalities")
        if outs is not None and (not outs or "text" not in outs):
            continue  # audio/image-only endpoints cannot translate
        if outs and ("audio" in outs or "image" in outs):
            continue  # media generators also emit text; keep them out
        pricing = row.get("pricing") or {}
        try:
            free = (float(pricing.get("prompt", "1") or 1) == 0
                    and float(pricing.get("completion", "1") or 1) == 0)
        except (TypeError, ValueError):
            free = False
        if not (free or mid.endswith(":free")):
            continue
        ctx = row.get("context_length")
        models.append({
            "id": mid,
            "name": row.get("name") or mid,
            "ctx": f"{ctx // 1000}K" if isinstance(ctx, int) and ctx else "",
        })
    models.sort(key=lambda m: m["name"].lower())
    if models:
        write_json(MODELS_CACHE, {"fetched": time.time(), "base": base_url,
                                  "models": models})
        return models
    if isinstance(cached, dict) and cached.get("models"):
        return cached["models"]
    return []


def last_model():
    try:
        with open(LAST_MODEL) as f:
            return f.read().strip()
    except OSError:
        return ""


def save_last_model(model):
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        with open(LAST_MODEL, "w") as f:
            f.write(model)
    except OSError:
        pass


def resolve_model(cfg, base_url):
    """Pinned config model, else last picked, else first live free model."""
    pinned = os.environ.get("HT_MODEL") or cfg.get("model", "")
    if pinned:
        return pinned
    last = last_model()
    if last:
        return last
    models = fetch_models(base_url, int(cfg.get("models_ttl_secs", MODELS_TTL)))
    return models[0]["id"] if models else ""


def write_clipboard(text):
    # wl-copy forks a daemon to serve the clipboard offer and the child
    # inherits our fds, so stdout/stderr must go to DEVNULL or communicate()
    # waits for EOF forever (whispers spawns it with stdio null likewise).
    try:
        p = subprocess.run(["wl-copy"], input=text, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired) as e:
        die("wl-copy failed", str(e))
    if p.returncode != 0:
        die("wl-copy failed", f"exit {p.returncode}")


def translate(base_url, api_key, model, text, timeout, prompt):
    body = json.dumps({
        "model": model,
        "temperature": 0.2,
        "max_tokens": 512,
        "messages": [
            {"role": "system", "content": prompt},
            {"role": "user", "content": text},
        ],
    }).encode()
    req = urllib.request.Request(
        base_url.rstrip("/") + "/chat/completions",
        data=body,
        headers={
            "Authorization": f"Bearer {api_key}",
            "Content-Type": "application/json",
            "HTTP-Referer": "https://github.com/xqqmdy/hotkey-translation",
            "X-Title": "hotkey-translation",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            payload = json.loads(resp.read().decode())
    except urllib.error.HTTPError as e:
        try:
            detail = e.read().decode()[:300]
        except OSError:
            detail = ""
        if e.code == 401:
            die("OpenRouter auth failed (401)", "check openrouter_api_key in config")
        if e.code == 402:
            die("OpenRouter payment required (402)", detail or "free model unavailable")
        if e.code == 404:
            die("model not found (404)", "free model IDs rotate, run: hotkey-translation --pick")
        if e.code == 429:
            die("rate limited (429)", "free tier quota hit, wait and retry")
        die(f"OpenRouter HTTP {e.code}", detail)
    except urllib.error.URLError as e:
        die("network error", str(e.reason)[:200])
    try:
        content = payload["choices"][0]["message"]["content"]
    except (KeyError, IndexError, TypeError):
        die("bad API response", json.dumps(payload)[:300])
    out = content.strip()
    if len(out) >= 2 and out[0] == out[-1] and out[0] in ("\"", "'", "\u201c"):
        out = out[1:-1].strip()
    if not out:
        die("empty translation", "model returned nothing")
    return out


def main():
    cfg = load_config(os.environ.get("HT_CONFIG", CONFIG_DEFAULT))
    api_key = os.environ.get("OPENROUTER_API_KEY") or cfg.get("openrouter_api_key", "")
    base_url = os.environ.get("OPENROUTER_BASE_URL") or cfg.get("base_url", DEFAULT_BASE_URL)
    try:
        timeout = int(cfg.get("timeout_secs", 30))
    except (TypeError, ValueError):
        timeout = 30
    try:
        ttl = int(cfg.get("models_ttl_secs", MODELS_TTL))
    except (TypeError, ValueError):
        ttl = MODELS_TTL

    if not api_key or api_key == "PASTE_YOUR_KEY_HERE":
        die("missing API key", "fill openrouter_api_key in ~/.config/hotkey-translation/config.toml", 2)

    model = resolve_model(cfg, base_url)

    # --pick: model chooser only, no translation. Bound to its own hotkey so
    # the normal flow never asks for a model.
    if "--pick" in sys.argv[1:]:
        if shutil.which("fuzzel") is None:
            die("fuzzel not found", "the picker needs fuzzel", 2)
        models = fetch_models(base_url, ttl)
        if not models:
            die("no free models", "cannot fetch the model list; check network")
        chosen = prompt_model(models, model)
        if not chosen:
            sys.exit(0)  # Esc
        save_last_model(chosen)
        print(chosen)
        notify("translation model", chosen)
        return

    if not model:
        die("no model", "run: hotkey-translation --pick", 2)

    src_code = os.environ.get("HT_SOURCE") or cfg.get("source_lang", "zh")
    dst_code = os.environ.get("HT_TARGET") or cfg.get("target_lang", "en")
    if not src_code or not dst_code:
        die("missing language", "set source_lang/target_lang in the config", 2)
    src_name = lang_name(src_code)
    dst_name = lang_name(dst_code)
    prompt = build_prompt(src_code, dst_code)
    ime_source = (src_code or "").lower() in IME_SOURCE

    use_fuzzel = shutil.which("fuzzel") is not None

    text = os.environ.get("HT_TEXT")
    if not text:
        if use_fuzzel:
            text = prompt_text(f"输入{src_name}，回车译成{dst_name}", ime_source)
            if not text:
                sys.exit(0)  # Esc or empty input
        else:
            text = read_clipboard()
            if not text:
                die("clipboard is empty", "select text, Ctrl+C, then hotkey again")

    result = translate(base_url, api_key, model, text, timeout, prompt)
    write_clipboard(result)
    print(result)
    notify(f"translate [{model.split('/')[-1][:40]}]", result)


if __name__ == "__main__":
    main()
