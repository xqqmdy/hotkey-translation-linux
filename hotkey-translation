ROFI_THEME_FILE = os.path.expanduser("~/.cache/hotkey-translation/theme.rasi")


def theme_file(lines, placeholder=""):
    """Write the theme and return its path.

    rofi drops the message widget when the theme comes from -theme-str, so the
    theme goes through a file instead; that keeps the model line visible.
    """
    theme = ROFI_THEME.replace("lines: 12;", f"lines: {lines};")
    if placeholder:
        theme += ('\nentry { placeholder: "%s"; }'
                  % placeholder.replace('"', ""))
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        tmp = ROFI_THEME_FILE + f".{os.getpid()}"
        with open(tmp, "w") as f:
            f.write(theme + "\n")
        os.replace(tmp, ROFI_THEME_FILE)
    except OSError:
        return None
    return ROFI_THEME_FILE


def model_rows(models):
    """Rows for the model window: name, context, and the id in brackets.
    The "(free)" label is stripped so ordinary words do not match every
    free model when filtering."""
    rows = []
    for m in models:
        name = (m["name"] or m["id"]).replace("(free)", "").strip()
        rows.append(f"{name}  {m['ctx']}  [{m['id']}]")
    return rows


def parse_model_row(row):
    if row.endswith("]") and "[" in row:
        return row.rsplit("[", 1)[1][:-1].strip()
    return ""


def pick_model(models, current):
    """Model window: rofi dmenu over the live free list, Enter picks.
    Model ids are ASCII, so the IME is set to English for the dialog and the
    previous mode is restored afterwards."""
    cmd = ["rofi", "-dmenu", "-i", "-p", "free model",
           "-mesg", f"current: {current}    Enter: select    Esc: back",
           "-theme", theme_file(12, "Filter models")]
    prev = rime_ascii()
    if prev is not None:
        rime_force(True)
    proc = subprocess.run(cmd, input="\n".join(model_rows(models)) + "\n",
                          capture_output=True, text=True)
    if prev is not None:
        rime_force(prev)
    if proc.returncode != 0:
        return None
    return parse_model_row(proc.stdout.strip())


def translate_window(info, prompt, placeholder, ime_mode):
    """Text window.

    -format f returns the typed filter instead of a selected row, so Enter
    always submits the text (rofi refuses custom entries otherwise). The
    custom key Ctrl+Tab exits with code 10, which switches to the model window.
    """
    cmd = ["rofi", "-dmenu", "-format", "f", "-p", prompt,
           "-mesg", info + "    Ctrl+Tab: models",
           "-kb-custom-1", "Control+Tab",
           # rofi binds Ctrl+Tab to mode-next by default; free it so the
           # custom key gets through.
           "-kb-mode-next", "",
           "-font", "monospace 12",
           "-theme", theme_file(1, placeholder)]
    prev = rime_ascii()
    # Only touch the IME when the source is Chinese or Latin: forcing English
    # for a Japanese or Korean source would send its keystrokes to the ASCII
    # path and break input. None means leave the user's mode alone.
    use_ime = prev is not None and ime_mode is not None
    if use_ime:
        rime_apply(ime_ascii(ime_mode))
        time.sleep(0.15)
    try:
        proc = subprocess.run(cmd, stdin=subprocess.DEVNULL,
                              capture_output=True, text=True)
    finally:
        if use_ime:
            rime_force(True)  # leave English behind, no verification delay
    return proc.returncode, proc.stdout.strip()


CACHE_DIR = os.path.expanduser("~/.cache/hotkey-translation")
MODELS_CACHE = os.path.join(CACHE_DIR, "models.json")
LAST_MODEL = os.path.join(CACHE_DIR, "last_model")
MODELS_TTL = 86400


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def write_json(path, data):
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            json.dump(data, f)
        os.replace(tmp, path)
    except OSError:
        pass


def filter_models(rows):
    """Free, text-only models from a raw /models payload.

    Applied on every read, so rule changes take effect immediately instead of
    waiting for the cache to expire.
    """
    models = []
    for row in rows or []:
        mid = row.get("id") or ""
        if not mid:
            continue
        arch = row.get("architecture") or {}
        outs = arch.get("output_modalities")
        if outs is not None and (not outs or "text" not in outs):
            continue  # audio/image-only endpoints cannot translate
        if outs and ("audio" in outs or "image" in outs):
            continue  # media generators also emit text; keep them out
        pricing = row.get("pricing") or {}
        try:
            free = (float(pricing.get("prompt", "1") or 1) == 0
                    and float(pricing.get("completion", "1") or 1) == 0)
        except (TypeError, ValueError):
            free = False
        if not (free or mid.endswith(":free")):
            continue
        ctx = row.get("context_length")
        models.append({
            "id": mid,
            "name": row.get("name") or mid,
            "ctx": f"{ctx // 1000}K" if isinstance(ctx, int) and ctx else "",
        })
    models.sort(key=lambda m: m["name"].lower())
    return models


def download_models(base_url):
    """Raw /models payload, or None on failure."""
    url = base_url.rstrip("/") + "/models"
    try:
        req = urllib.request.Request(url, headers={
            "HTTP-Referer": "https://github.com/xqqmdy/hotkey-translation",
            "X-Title": "hotkey-translation",
        })
        with urllib.request.urlopen(req, timeout=8) as resp:
            payload = json.loads(resp.read().decode())
        return payload.get("data") or None
    except (urllib.error.URLError, ValueError, OSError):
        return None


def write_models_cache(base_url, rows):
    write_json(MODELS_CACHE, {"fetched": time.time(), "base": base_url,
                              "data": rows})


def refresh_in_background():
    """Update the cache without making the user wait for the network."""
    try:
        subprocess.Popen([sys.executable, os.path.realpath(sys.argv[0]),
                          "--refresh-models"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


def fetch_models(base_url, ttl):
    """Free models for the window.

    The cache holds the raw /models payload and filters run on read. A fresh
    cache is used without network. A stale one is served immediately and
    refreshed in the background, so the hotkey never blocks on /models. Only a
    missing cache costs one blocking fetch. The older cache format (filtered
    "models") is still read as a fallback.
    """
    cached = read_json(MODELS_CACHE)
    legacy = None
    if isinstance(cached, dict) and cached.get("base") == base_url:
        age = time.time() - cached.get("fetched", 0)
        rows = cached.get("data")
        if rows:
            models = filter_models(rows)
            if age < ttl:
                return models
            if models:
                refresh_in_background()
                return models
        legacy = cached.get("models")

    rows = download_models(base_url)
    if rows:
        write_models_cache(base_url, rows)
        return filter_models(rows)

    return legacy or []


def last_model():
    try:
        with open(LAST_MODEL) as f:
            return f.read().strip()
    except OSError:
        return ""


def save_last_model(model):
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        with open(LAST_MODEL, "w") as f:
            f.write(model)
    except OSError:
        pass


def resolve_model(cfg, base_url):
    """Pinned config model, else last picked, else first live free model."""
    pinned = os.environ.get("HT_MODEL") or cfg.get("model", "")
    if pinned:
        return pinned
    last = last_model()
    if last:
        return last
    models = fetch_models(base_url, int(cfg.get("models_ttl_secs", MODELS_TTL)))
    return models[0]["id"] if models else ""


def post_chat(base_url, api_key, payload, timeout):
    req = urllib.request.Request(
        base_url.rstrip("/") + "/chat/completions",
        data=json.dumps(payload).encode(),
        headers={
            "Authorization": f"Bearer {api_key}",
            "Content-Type": "application/json",
            "HTTP-Referer": "https://github.com/xqqmdy/hotkey-translation",
            "X-Title": "hotkey-translation",
        },
    )
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read().decode())


def read_error(e):
    try:
        return e.read().decode()[:300]
    except OSError:
        return ""


def api_error(e, detail):
    if e.code == 401:
        die("OpenRouter auth failed (401)", "check openrouter_api_key in config")
    if e.code == 402:
        die("OpenRouter payment required (402)", detail or "free model unavailable")
    if e.code == 404:
        die("model not found (404)", "free model IDs rotate, run: hotkey-translation --pick")
    if e.code == 429:
        die("rate limited (429)", "free tier quota hit, wait and retry")
    die(f"OpenRouter HTTP {e.code}", detail)


def translate(base_url, api_key, model, text, timeout, prompt,
              max_tokens=DEFAULT_MAX_TOKENS):
    payload = {
        "model": model,
        "temperature": 0.2,
        "max_tokens": max_tokens,
        "messages": [
            {"role": "system", "content": prompt},
            {"role": "user", "content": text},
        ],
    }
    cache_key = (base_url, model)
    if cache_key not in REASONING_UNSUPPORTED:
        payload["reasoning"] = {"enabled": False}
    try:
        try:
            data = post_chat(base_url, api_key, payload, timeout)
        except urllib.error.HTTPError as e:
            detail = read_error(e)
            # A 400 can mean the endpoint rejects the reasoning flag; retry
            # once without it and surface the retry's error if that fails too.
            if e.code != 400 or "reasoning" not in payload:
                api_error(e, detail)
            REASONING_UNSUPPORTED.add(cache_key)
            payload.pop("reasoning")
            data = post_chat(base_url, api_key, payload, timeout)
    except urllib.error.HTTPError as e:
        api_error(e, read_error(e))
    except urllib.error.URLError as e:
        die("network error", str(e.reason)[:200])
    try:
        choice = data["choices"][0]
        content = choice["message"]["content"]
    except (KeyError, IndexError, TypeError):
        die("bad API response", json.dumps(data)[:300])
    if content is None:
        usage = data.get("usage") or {}
        spent = (usage.get("completion_tokens_details") or {}).get("reasoning_tokens")
        die("model returned no translation",
            f"finish_reason={choice.get('finish_reason')}, "
            f"reasoning_tokens={spent}: the model spent the whole token "
            f"budget ({max_tokens}) thinking; raise max_tokens in the config "
            "or run: hotkey-translation --pick")
    out = content.strip()
    if len(out) >= 2 and out[0] == out[-1] and out[0] in ("\"", "'", "\u201c"):
        out = out[1:-1].strip()
    if not out:
        die("empty translation", "model returned nothing")
    return out


def main():
    cfg = load_config(os.environ.get("HT_CONFIG", CONFIG_DEFAULT))
    base_url = os.environ.get("OPENROUTER_BASE_URL") or cfg.get("base_url", DEFAULT_BASE_URL)

    if "--refresh-models" in sys.argv[1:]:
        rows = download_models(base_url)
        if rows:
            write_models_cache(base_url, rows)
        return

    api_key = os.environ.get("OPENROUTER_API_KEY") or cfg.get("openrouter_api_key", "")
    try:
        timeout = int(cfg.get("timeout_secs", 30))
    except (TypeError, ValueError):
        timeout = 30
    try:
        ttl = int(cfg.get("models_ttl_secs", MODELS_TTL))
    except (TypeError, ValueError):
        ttl = MODELS_TTL
    try:
        max_tokens = int(cfg.get("max_tokens", DEFAULT_MAX_TOKENS))
    except (TypeError, ValueError):
        max_tokens = DEFAULT_MAX_TOKENS

    if not api_key or api_key == "PASTE_YOUR_KEY_HERE":
        die("missing API key", "fill openrouter_api_key in ~/.config/hotkey-translation/config.toml", 2)

    model = resolve_model(cfg, base_url)

    # --pick: model chooser only, no translation. Bound to its own hotkey so
    # the normal flow never asks for a model.
    if "--list-models" in sys.argv[1:]:
        for row in model_rows(fetch_models(base_url, ttl)):
            print(row)
        return

    if "--pick" in sys.argv[1:]:
        if shutil.which("rofi") is None:
            die("rofi not found", "the picker needs rofi", 2)
        models = fetch_models(base_url, ttl)
        if not models:
            die("no free models", "cannot fetch the model list; check network")
        chosen = pick_model(models, model)
        if chosen:
            save_last_model(chosen)
            print(chosen)
            notify("translation model", chosen)
        return

    if not model:
        die("no model", "run: hotkey-translation --pick", 2)

    src_code = os.environ.get("HT_SOURCE") or cfg.get("source_lang", "zh")
    dst_code = os.environ.get("HT_TARGET") or cfg.get("target_lang", "en")
    if not src_code or not dst_code:
        die("missing language", "set source_lang/target_lang in the config", 2)
    src_name = lang_name(src_code)
    dst_name = lang_name(dst_code)
    prompt = build_prompt(src_code, dst_code)
    ime_mode_value = ime_mode(src_code)
    cached_rows = (read_json(MODELS_CACHE) or {}).get("data") or []
    label = model_label(model, filter_models(cached_rows))
    info = f"model: {label}  \u00b7  {src_code} \u2192 {dst_code}"

    use_rofi = shutil.which("rofi") is not None

    text = os.environ.get("HT_TEXT")
    if not text:
        if not use_rofi:
            text = read_clipboard()
            if not text:
                die("clipboard is empty", "select text, Ctrl+C, then hotkey again")
        else:
            models = fetch_models(base_url, ttl)
            while True:
                rc, typed = translate_window(
                    info, f"{src_code}\u2192{dst_code}",
                    f"Type {lang_name(src_code)}, Enter to translate to "
                    f"{lang_name(dst_code)}", ime_mode_value)
                if rc == 10:
                    chosen = pick_model(models, model)
                    if chosen:
                        model = chosen
                        save_last_model(model)
                        info = (f"model: {model_label(model, models)}  \u00b7  "
                                f"{src_code} \u2192 {dst_code}")
                    continue
                if rc != 0 or not typed:
                    sys.exit(0)
                models2 = fetch_models(base_url, ttl)
                if typed.strip() in {m["id"] for m in models2}:
                    model = typed.strip()
                    save_last_model(model)
                    info = (f"model: {model_label(model, models2)}  \u00b7  "
                            f"{src_code} \u2192 {dst_code}")
                    continue
                text = typed
                break

    result = translate(base_url, api_key, model, text, timeout, prompt, max_tokens)
    write_clipboard(result)
    print(result)
    notify(f"translate [{model.split('/')[-1][:40]}]", result)


if __name__ == "__main__":
    main()
